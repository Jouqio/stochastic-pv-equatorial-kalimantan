# ── Data & large files ──────────────────────────────────────
*.csv.gz
*.parquet
*.h5
*.hdf5
# Keep data/*.csv tracked (NASA POWER raw data is small)
!data/*.csv

# ── Output artifacts ─────────────────────────────────────────
# Keep figures tracked (publication assets)
!figures/*.png
!figures/*.pdf
# Ignore generated Word docs in root (keep only in docs/)
*.docx
!docs/*.docx

# ── OS files ─────────────────────────────────────────────────
